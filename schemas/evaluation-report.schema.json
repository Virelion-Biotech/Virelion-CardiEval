{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CardiEval EvaluationReport",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evaluator_version","benchmark_id","benchmark_version","benchmark_sha256","task","split","model_id","ground_truth_source","created_at","metrics","subgroups","warnings","errors"],
  "properties":{
    "schema_version":{"type":"string"},
    "evaluator_version":{"type":"string","minLength":1},
    "benchmark_id":{"type":"string","minLength":1},
    "benchmark_version":{"type":"string","minLength":1},
    "benchmark_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "task":{"enum":["classification","binary_classification","regression","ranking"]},
    "split":{"enum":["train","validation","test","external"]},
    "model_id":{"type":"string","minLength":1},
    "task_id":{"type":["string","null"]},
    "primary_metric":{"type":["string","null"]},
    "primary_value":{"type":["number","null"]},
    "primary_direction":{"type":["string","null"]},
    "ground_truth_source":{"enum":["benchmark_manifest","submission"]},
    "created_at":{"type":"string","format":"date-time"},
    "metrics":{"type":"array"},
    "subgroups":{"type":"array"},
    "warnings":{"type":"array","items":{"type":"string"}},
    "errors":{"type":"array","items":{"type":"string"}}
  }
}