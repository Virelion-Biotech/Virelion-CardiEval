{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CardiEval Benchmark Package",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","version","manifest","tasks"],
  "properties":{
    "schema_version":{"type":"string"},
    "benchmark_id":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "manifest":{
      "type":"object","additionalProperties":false,
      "required":["benchmark_id","version","task","split","sample_ids","dataset_sha256"],
      "properties":{
        "benchmark_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "task":{"enum":["classification","binary_classification","regression","ranking"]},
        "split":{"enum":["train","validation","test","external"]},
        "sample_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "dataset_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "label_schema":{"type":"object","additionalProperties":{"type":"string"}},
        "metadata":{"type":"object","additionalProperties":{"type":"string"}},
        "authoritative_labels":{"type":"object"},
        "authoritative_subgroups":{"type":"object","additionalProperties":{"type":"string"}}
      }
    },
    "tasks":{"type":"array","minItems":1},
    "artifacts":{"type":"array"},
    "metadata":{"type":"object","additionalProperties":{"type":"string"}}
  }
}