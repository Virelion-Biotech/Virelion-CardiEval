{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CardiEval Benchmark Package",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","version","manifest","tasks"],
  "properties":{
    "schema_version":{"type":"string","minLength":1},
    "benchmark_id":{"type":"string","minLength":1},
    "version":{"type":"string","minLength":1},
    "manifest":{
      "type":"object","additionalProperties":false,
      "required":["benchmark_id","version","task","split","sample_ids","dataset_sha256"],
      "properties":{
        "benchmark_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "task":{"enum":["classification","binary_classification","regression","ranking"]},
        "split":{"enum":["train","validation","test","external"]},
        "sample_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "dataset_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "label_schema":{"type":"object","additionalProperties":{"type":"string"}},
        "metadata":{"type":"object","additionalProperties":{"type":"string"}},
        "authoritative_labels":{"type":["object","null"]},
        "authoritative_subgroups":{"type":["object","null"],"additionalProperties":{"type":"string"}}
      }
    },
    "tasks":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["benchmark_id","version","task_id","task_type","allowed_metrics","primary_metric","primary_direction","splits"],
        "properties":{
          "benchmark_id":{"type":"string","minLength":1},
          "version":{"type":"string","minLength":1},
          "task_id":{"type":"string","minLength":1},
          "task_type":{"enum":["classification","binary_classification","regression","ranking"]},
          "allowed_metrics":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "primary_metric":{"type":"string","minLength":1},
          "primary_direction":{"enum":["higher_is_better","lower_is_better"]},
          "splits":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["train","validation","test","external"]}},
          "description":{"type":"string"},
          "requires_authoritative_labels":{"type":"boolean"}
        }
      }
    },
    "artifacts":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["path","sha256","kind","size_bytes"],
        "properties":{
          "path":{"type":"string","pattern":"^(?!/)(?!.*(^|/)\\\\.\\\\.(/|$)).+"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "kind":{"type":"string","minLength":1},
          "size_bytes":{"type":"integer","minimum":0}
        }
      }
    },
    "metadata":{"type":"object","additionalProperties":{"type":"string"}}
  }
}