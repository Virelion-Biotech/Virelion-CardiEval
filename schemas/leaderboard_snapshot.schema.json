{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CardiEval LeaderboardSnapshot",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","benchmark_version","task_id","split","primary_metric","primary_direction","n_bundles","n_models","bundles","leaderboard"],
  "properties":{
    "schema_version":{"type":"string","minLength":1},
    "benchmark_id":{"type":"string","minLength":1},
    "benchmark_version":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},
    "split":{"type":"string","minLength":1},
    "primary_metric":{"type":"string","minLength":1},
    "primary_direction":{"enum":["higher_is_better","lower_is_better"]},
    "n_bundles":{"type":"integer","minimum":1},
    "n_models":{"type":"integer","minimum":1},
    "bundles":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","pattern":"^[0-9a-f]{64}$"}
    },
    "leaderboard":{
      "type":"object","additionalProperties":false,
      "required":["benchmark_id","benchmark_version","split","metric","direction","entries"],
      "properties":{
        "benchmark_id":{"type":"string","minLength":1},
        "benchmark_version":{"type":"string","minLength":1},
        "split":{"type":"string","minLength":1},
        "metric":{"type":"string","minLength":1},
        "direction":{"enum":["higher_is_better","lower_is_better"]},
        "entries":{
          "type":"array",
          "items":{
            "type":"object","additionalProperties":false,
            "required":["rank","model_id","score","n_reports","benchmarks"],
            "properties":{
              "rank":{"type":"integer","minimum":1},
              "model_id":{"type":"string","minLength":1},
              "score":{"type":"number"},
              "n_reports":{"type":"integer","minimum":1},
              "benchmarks":{"type":"array","items":{"type":"string"}}
            }
          }
        }
      }
    }
  }
}