{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardiEval Evaluation Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "benchmark_id",
    "benchmark_version",
    "task_id",
    "model_id",
    "benchmark_package_sha256",
    "submission_sha256",
    "evaluation_fingerprint",
    "bundle_id",
    "report_path",
    "bundle_path",
    "created_at"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "benchmark_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "submission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_path": {"type": "string", "minLength": 1},
    "bundle_path": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
